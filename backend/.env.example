# PAWVET Backend — copia a .env y completa. NUNCA commitear .env
NODE_ENV=development
PORT=3001

# PocketBase (URL del servidor + credenciales de superuser/admin)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@pawvet.net
POCKETBASE_ADMIN_PASSWORD=

# Encriptación datos médicos — 32 bytes hex (openssl rand -hex 32)
MEDICAL_DATA_ENCRYPTION_KEY=

# Transbank WebPay (sandbox por defecto)
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENV=integration

# Google Maps
GOOGLE_MAPS_API_KEY=

# SendGrid
SENDGRID_API_KEY=
EMAIL_FROM=noreply@pawvet.net

# Firebase Cloud Messaging (service account JSON path)
FCM_SERVICE_ACCOUNT_PATH=
