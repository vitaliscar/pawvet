{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://api.pawvet.net/pb",
        "EXPO_PUBLIC_API_URL": "https://api.pawvet.net",
        "EXPO_PUBLIC_WEB_URL": "https://pawvet.net"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://api.pawvet.net/pb",
        "EXPO_PUBLIC_API_URL": "https://api.pawvet.net",
        "EXPO_PUBLIC_WEB_URL": "https://pawvet.net"
      }
    }
  }
}
