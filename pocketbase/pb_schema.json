[
  {
    "name": "users",
    "type": "auth",
    "listRule": "id = @request.auth.id || @request.auth.role = 'admin'",
    "viewRule": "id = @request.auth.id || @request.auth.role = 'admin'",
    "createRule": "",
    "updateRule": "id = @request.auth.id && @request.body.role:changed = false",
    "deleteRule": "@request.auth.role = 'admin'",
    "fields": [
      { "name": "phone", "type": "text", "required": false, "max": 20 },
      {
        "name": "role",
        "type": "select",
        "required": true,
        "values": ["owner", "vet", "admin"],
        "maxSelect": 1
      }
    ]
  },
  {
    "name": "pet_owners",
    "type": "base",
    "listRule": "user_id = @request.auth.id || @request.auth.role = 'admin'",
    "viewRule": "user_id = @request.auth.id || @request.auth.role = 'admin'",
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "fields": [
      { "name": "user_id", "type": "relation", "required": true, "collectionId": "users", "maxSelect": 1 },
      { "name": "full_name", "type": "text", "required": true, "max": 200 },
      { "name": "address", "type": "text", "max": 300 },
      { "name": "lat", "type": "number" },
      { "name": "lon", "type": "number" },
      { "name": "preferred_radius_km", "type": "number", "required": true },
      { "name": "verified", "type": "bool" },
      { "name": "terms_accepted_at", "type": "date" },
      { "name": "privacy_accepted_at", "type": "date" },
      { "name": "created", "type": "autodate", "onCreate": true },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ]
  },
  {
    "name": "veterinarians",
    "type": "base",
    "listRule": "verified = true || user_id = @request.auth.id || @request.auth.role = 'admin'",
    "viewRule": "verified = true || user_id = @request.auth.id || @request.auth.role = 'admin'",
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "fields": [
      { "name": "user_id", "type": "relation", "required": true, "collectionId": "users", "maxSelect": 1 },
      { "name": "full_name", "type": "text", "required": true, "max": 200 },
      { "name": "rut", "type": "text", "required": true, "hidden": true },
      { "name": "license_number", "type": "text", "required": true },
      { "name": "clinic_name", "type": "text", "max": 200 },
      { "name": "clinic_address", "type": "text", "max": 300 },
      { "name": "clinic_lat", "type": "number" },
      { "name": "clinic_lon", "type": "number" },
      { "name": "bio", "type": "text", "max": 2000 },
      { "name": "avatar_url", "type": "url" },
      { "name": "phone", "type": "text", "max": 20, "hidden": true },
      { "name": "verified", "type": "bool" },
      { "name": "rut_document_url", "type": "url", "hidden": true },
      { "name": "license_document_url", "type": "url", "hidden": true },
      { "name": "verified_by_admin_id", "type": "relation", "collectionId": "users", "maxSelect": 1, "hidden": true },
      { "name": "verified_at", "type": "date" },
      {
        "name": "subscription_status",
        "type": "select",
        "values": ["active", "cancelled", "expired"],
        "maxSelect": 1
      },
      {
        "name": "subscription_plan",
        "type": "select",
        "values": ["basic", "pro", "premium"],
        "maxSelect": 1
      },
      { "name": "subscription_start", "type": "date" },
      { "name": "subscription_end", "type": "date" },
      { "name": "offers_home_visits", "type": "bool" },
      { "name": "offers_clinic_visits", "type": "bool" },
      { "name": "independent_contractor_agreement_signed", "type": "bool" },
      { "name": "agreement_signed_at", "type": "date" },
      { "name": "has_liability_insurance", "type": "bool" },
      { "name": "insurance_expiry", "type": "date" },
      { "name": "created", "type": "autodate", "onCreate": true },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ]
  },
  {
    "name": "pets",
    "type": "base",
    "listRule": "owner_id.user_id = @request.auth.id || @request.auth.role = 'admin'",
    "viewRule": "owner_id.user_id = @request.auth.id || @request.auth.role = 'admin'",
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "fields": [
      { "name": "owner_id", "type": "relation", "required": true, "collectionId": "pet_owners", "maxSelect": 1 },
      { "name": "name", "type": "text", "required": true, "max": 100 },
      {
        "name": "species",
        "type": "select",
        "required": true,
        "values": ["dog", "cat", "bird", "rabbit", "other"],
        "maxSelect": 1
      },
      { "name": "breed", "type": "text", "max": 100 },
      { "name": "age_years", "type": "number" },
      { "name": "medical_history_enc", "type": "text", "max": 40000 },
      { "name": "photo_url", "type": "url" },
      { "name": "created", "type": "autodate", "onCreate": true },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ]
  },
  {
    "name": "vet_availability",
    "type": "base",
    "listRule": "",
    "viewRule": "",
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "fields": [
      { "name": "vet_id", "type": "relation", "required": true, "collectionId": "veterinarians", "maxSelect": 1 },
      { "name": "weekday", "type": "number", "required": true },
      { "name": "start_time", "type": "text", "required": true },
      { "name": "end_time", "type": "text", "required": true },
      {
        "name": "service_type",
        "type": "select",
        "required": true,
        "values": ["home_visit", "clinic_visit"],
        "maxSelect": 1
      },
      { "name": "price_clp", "type": "number", "required": true },
      { "name": "created", "type": "autodate", "onCreate": true },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ]
  },
  {
    "name": "vet_services",
    "type": "base",
    "listRule": "",
    "viewRule": "",
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "fields": [
      { "name": "vet_id", "type": "relation", "required": true, "collectionId": "veterinarians", "maxSelect": 1 },
      {
        "name": "kind",
        "type": "select",
        "required": true,
        "values": ["general_consult", "vaccination", "deworming", "wellness_check"],
        "maxSelect": 1
      },
      { "name": "duration_min", "type": "number", "required": true },
      { "name": "price_clp", "type": "number", "required": true },
      { "name": "home_visit_fee_clp", "type": "number" },
      { "name": "active", "type": "bool" },
      { "name": "created", "type": "autodate", "onCreate": true },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_vet_services_kind ON vet_services (vet_id, kind)"]
  },
  {
    "name": "appointments",
    "type": "base",
    "listRule": "owner_id.user_id = @request.auth.id || vet_id.user_id = @request.auth.id || @request.auth.role = 'admin'",
    "viewRule": "owner_id.user_id = @request.auth.id || vet_id.user_id = @request.auth.id || @request.auth.role = 'admin'",
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "fields": [
      { "name": "pet_id", "type": "relation", "required": true, "collectionId": "pets", "maxSelect": 1 },
      { "name": "vet_id", "type": "relation", "required": true, "collectionId": "veterinarians", "maxSelect": 1 },
      { "name": "owner_id", "type": "relation", "required": true, "collectionId": "pet_owners", "maxSelect": 1 },
      {
        "name": "service_type",
        "type": "select",
        "required": true,
        "values": ["home_visit", "clinic_visit"],
        "maxSelect": 1
      },
      { "name": "service_lat", "type": "number" },
      { "name": "service_lon", "type": "number" },
      { "name": "distance_km", "type": "number" },
      { "name": "scheduled_date", "type": "text", "required": true },
      { "name": "scheduled_time", "type": "text", "required": true },
      { "name": "actual_date", "type": "date" },
      { "name": "price_clp", "type": "number" },
      {
        "name": "status",
        "type": "select",
        "required": true,
        "values": ["pending", "confirmed", "completed", "cancelled"],
        "maxSelect": 1
      },
      { "name": "vet_notes_enc", "type": "text", "max": 40000 },
      { "name": "diagnosis_enc", "type": "text", "max": 40000 },
      { "name": "treatment_enc", "type": "text", "max": 40000 },
      { "name": "medications_enc", "type": "text", "max": 40000 },
      { "name": "follow_up_required", "type": "bool" },
      { "name": "owner_rating", "type": "number" },
      { "name": "owner_review", "type": "text" },
      { "name": "vet_rating", "type": "number" },
      { "name": "service_id", "type": "relation", "collectionId": "vet_services", "maxSelect": 1 },
      { "name": "idempotency_key", "type": "text", "max": 100 },
      { "name": "cancel_reason", "type": "text", "max": 500 },
      { "name": "created", "type": "autodate", "onCreate": true },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": [
      "CREATE UNIQUE INDEX idx_appointments_slot ON appointments (vet_id, scheduled_date, scheduled_time) WHERE status != 'cancelled'",
      "CREATE UNIQUE INDEX idx_appointments_idempotency ON appointments (owner_id, idempotency_key) WHERE idempotency_key != ''"
    ]
  },
